{
 "cleanUrls": true,
 "trailingSlash": false,
 "headers": [
  {
   "source": "/deals/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate"
    }
   ]
  },
  {
   "source": "/deals",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate"
    }
   ]
  }
 ],
 "redirects": [
  {
   "source": "/rent",
   "destination": "/deals/",
   "permanent": true
  },
  {
   "source": "/rent/",
   "destination": "/deals/",
   "permanent": true
  }
 ]
}